---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout>
  {
    articles.length === 0 ? null : (
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-2">
        {articles.map((article) => (
          <li>
            <a href={`/articles/${article.id}`} class="group block border border-black/10 p-6 hover:border-black/30 transition-colors">
              <p class="text-xs uppercase tracking-widest opacity-50 mb-3">{article.data.category}</p>
              <h2 class="font-serif text-2xl mb-3 group-hover:opacity-70 transition-opacity leading-snug">
                {article.data.title}
              </h2>
              <p class="opacity-60 text-sm mb-4 leading-relaxed">{article.data.description}</p>
              <time class="text-xs opacity-40 uppercase tracking-wide" datetime={article.data.date.toISOString()}>
                {article.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
