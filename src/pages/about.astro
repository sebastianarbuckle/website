---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About">
  <div class="py-10">
    <h1 class="font-serif text-4xl mb-6">About</h1>
    <p class="text-lg leading-relaxed opacity-80">
      Drunken Ninja covers film — new releases as they land, and the bigger conversations around
      them. Some pieces are reviews, some are arguments, some are just thoughts that needed
      somewhere to go.
    </p>
  </div>
</Layout>
